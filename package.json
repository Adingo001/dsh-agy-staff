{
  "name": "dsh-agy-staff",
  "version": "0.3.0",
  "description": "Hire Google's Antigravity CLI (agy) from DeepSeek Harness: seven /agy-* skills, an `agy` subagent provider, and a control panel to drive both.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./ui": "./agy-ui.js",
    "./settings": "./agy-settings.js",
    "./agy-subagent": "./agy-subagent.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "agy-subagent.js",
    "agy-settings.js",
    "agy-ui.js",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test test/",
    "vendor": "node scripts/vendor-upstream.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "agy",
    "agy-staff",
    "antigravity",
    "gemini",
    "skills",
    "subagent",
    "panel"
  ]
}
